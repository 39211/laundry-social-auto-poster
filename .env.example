# Defaults are safe: dry-run mode never calls Meta Graph API.
DRY_RUN=true
TIMEZONE=Asia/Taipei
META_GRAPH_API_VERSION=v25.0

# Required before live posting.
META_ACCESS_TOKEN=
FB_PAGE_ID=
IG_USER_ID=

# Optional but recommended for analytics. Use a token granted insight read permissions.
# If empty, analytics scripts fall back to META_ACCESS_TOKEN.
META_ANALYTICS_ACCESS_TOKEN=

# Used only by `npm run repair-meta-token`, which exchanges a fresh short-lived
# User Access Token for a permanent Page Access Token and writes it into
# META_ACCESS_TOKEN and META_ANALYTICS_ACCESS_TOKEN above.
# FB_APP_ID and FB_APP_SECRET come from App settings > Basic in the Meta app dashboard.
META_USER_TOKEN=
FB_APP_ID=
FB_APP_SECRET=

# Google Analytics 4 measurement id, format G-XXXXXXXXXX. When set,
# `generate-public-site` adds pageview tracking to every generated HTML page and
# keeps the LINE redirect page's line_click event. Leave empty to emit no tracking.
PUBLIC_GA4_MEASUREMENT_ID=

# Public HTTPS site base URL for SEO/AIO/GEO canonical pages, without /docs.
# Example: https://your-github-username.github.io
PUBLIC_SITE_BASE_URL=

# Optional Git remote for mirroring generated docs/ into the user/organization root Pages site.
# Example: https://github.com/your-github-username/your-github-username.github.io.git
PUBLIC_ROOT_PAGES_REPO=

# Public HTTPS asset base URL used for Meta image publishing, without /docs.
# This can be the same as PUBLIC_SITE_BASE_URL, or a separate image host.
# Example: https://your-site.netlify.app
PUBLIC_IMAGE_BASE_URL=

# Optional. Dry-run skips URL checks unless this is true.
VERIFY_PUBLIC_IMAGE_URL=false

# Optional. Enables first-party LINE click events on /go/line.html.
# Create a GA4 web stream for the public site and paste its G- measurement id.
PUBLIC_GA4_MEASUREMENT_ID=

# Official xAI API route for paid Grok Reel generation. A SuperGrok web
# subscription does not include API billing. Generation remains disabled unless
# both values are present and the command is called with --live.
XAI_API_KEY=
# Optional: reuse an existing trusted .env without copying its xAI key.
# When unset on Windows, the generator also checks %USERPROFILE%/AI/New project 2/.env.
XAI_CREDENTIAL_ENV_FILE=
XAI_VIDEO_BILLING_ACK=false
GROK_REELS_ENABLED=false
