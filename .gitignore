node_modules/
dist/
coverage/
.env
.env.*
!.env.example
.netlify/
data/*
!data/business-profile.json
data/posted-log/
*.log
.DS_Store

# Machine artifacts. Regenerated by the video, QA and browser tooling; keeping
# them out of git is what makes `git status` readable. Research notes, agent
# skills and docs/assets stay tracked because they are authored content.
video-production/.tools/
video-production/runs/
output/visual-qa/
output/playwright/
.playwright-cli/
**/chrome-profile/

# A blanket `git add -A` once swallowed 963 files and hundreds of megabytes of
# these; the hygiene audit measured ~600 MB of machine artifacts among the
# untracked set. output/ is local pipeline state (reels-run, logs, handoffs);
# .Codex/ is an agent bridge scratch area; the video-production research and
# reference trees are gigabytes of collected footage. None of it belongs in a
# repo whose public half is served from docs/.
output/
.Codex/
video-production/research/
video-production/references/
audits/service-page-visual-qa-2026-07-03/
research/**/*.verification-failure.png

# local credential files - never commit
secrets/

# Python bytecode cache; scripts/ holds a few .py helpers and their cache kept
# reappearing as untracked noise in every status check.
__pycache__/

# Reel QA frame dumps. extract-reel-frames.ps1 deliberately writes these
# beside the reel (F13), and the reel lives under docs/ - but the daily
# publish step git-adds all of docs/, so internal review frames were
# reaching the public Pages site.
docs/assets/**/*.frames/
docs/assets/**/*.qa-frames/
